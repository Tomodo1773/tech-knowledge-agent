{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION=japaneast}" },
    "resourceGroupName": { "value": "${AZURE_RESOURCE_GROUP}" },
    "principalId": { "value": "${AZURE_PRINCIPAL_ID}" },
    "principalType": { "value": "${AZURE_PRINCIPAL_TYPE}" },
    "budgetContactEmail": { "value": "${AZURE_BUDGET_CONTACT_EMAIL}" },
    "githubOwner": { "value": "${GITHUB_OWNER}" },
    "githubRepository": { "value": "${GITHUB_REPOSITORY}" },
    "githubDefaultBranch": { "value": "${GITHUB_DEFAULT_BRANCH=main}" },
    "slackTeamId": { "value": "${SLACK_ALLOWED_TEAM_ID}" },
    "slackUserId": { "value": "${SLACK_ALLOWED_USER_ID}" },
    "aiProjectDeploymentsJson": { "value": "${AI_PROJECT_DEPLOYMENTS=[]}" }
  }
}
